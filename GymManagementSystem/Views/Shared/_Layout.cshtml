<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymManagementSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymManagementSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark gym-navbar shadow-lg">
            <div class="container-fluid">

                <a class="navbar-brand d-flex align-items-center" asp-controller="Members" asp-action="Index">

                    <img src="~/images/gym-logo.png"
                         alt="Gym Manager"
                         width="45"
                         height="45"
                         class="me-2" />

                    <span class="fw-bold text-success">Gym Manager</span>

                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Members" asp-action="Index">
                                👥 Members
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Trainers" asp-action="Index">
                                🏋️ Trainers
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="MembershipPlans" asp-action="Index">
                                📋 Plans
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Payments" asp-action="Index">
                                💰 Payments
                            </a>
                        </li>

                    </ul>

                </div>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container text-white">
            &copy; 2026 - GymManagementSystem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
