@model GymManagementSystem.Models.Payment

@{
    ViewData["Title"] = "Details";
}

<div class="main-overlay">
    <div class="form-card">

        <h2 class="mb-4">🏋️ Payment Details</h2>

        <div>
            <h4>Payment</h4>
            <hr />
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Member)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Member.FullName)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Amount)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Amount)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.PaymentDate)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.PaymentDate)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.PaymentMethod)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.PaymentMethod)
                </dd>
            </dl>
        </div>
        <br />
        <div>
            <a asp-action="Edit" asp-route-id="@Model?.PaymentId" class="btn btn-primary">Edit</a> |
            <a asp-action="Index" class="btn btn-primary">Back to List</a>
        </div>
    </div>
</div>
