@model IEnumerable<GymManagementSystem.Models.Member>

@{
    ViewData["Title"] = "Index";
}

<div class="main-overlay">
    <div class="gym-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="text-white">🏋️ Gym Members</h1>

            <a asp-action="Create" class="btn btn-success">
                ➕ Add Member
            </a>
        </div>

        <div class="row mb-4">

            <div class="col-md-4">
                <div class="card text-white bg-primary shadow-lg">
                    <div class="card-body">
                        <h5>👥 Total Members</h5>
                        <h2>@ViewBag.TotalMembers</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card text-white bg-success shadow-lg">
                    <div class="card-body">
                        <h5>🟢 Active Members</h5>
                        <h2>@ViewBag.ActiveMembers</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card text-white bg-danger shadow-lg">
                    <div class="card-body">
                        <h5>🔴 Expired Members</h5>
                        <h2>@ViewBag.ExpiredMembers</h2>
                    </div>
                </div>
            </div>

        </div>


        <table class="table table-dark table-hover shadow-lg rounded">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.FullName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PhoneNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Email)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateOfBirth)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.JoinDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsActive)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.MembershipPlan)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Trainer)
                    </th>
                    <th>
                        Expiry Date
                    </th>
                    <th>
                        Status
                    </th>

                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.IsExpired ? "expired-row" : "")">
                        <td>
                            @Html.DisplayFor(modelItem => item.FullName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.PhoneNumber)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Email)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DateOfBirth)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.JoinDate)
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success px-3 py-2">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-danger px-3 py-2">No</span>
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.MembershipPlan.PlanName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Trainer.FullName)
                        </td>
                        <td>
                            @item.ExpiryDate.ToShortDateString()
                        </td>

                        <td>
                            @if (item.IsExpired)
                            {
                                <span class="badge bg-danger">Expired</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>

                        <td>
                            <a asp-action="Edit" asp-route-id="@item.MemberId">Edit</a> |
                            <a asp-action="Details" asp-route-id="@item.MemberId">Details</a> |
                            <a asp-action="Delete" asp-route-id="@item.MemberId">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>