@model GymManagementSystem.Models.MembershipPlan

@{
    ViewData["Title"] = "Details";
}

<div class="main-overlay">
    <div class="form-card">

        <h2 class="mb-4">🏋️ Plan Details</h2>

        <div>
            <h4>MembershipPlan</h4>
            <hr />
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.PlanName)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.PlanName)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.DurationInMonths)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.DurationInMonths)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Price)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Price)
                </dd>
            </dl>
        </div>
        <div>
            <a asp-action="Edit" class="btn btn-warning" asp-route-id="@Model?.MembershipPlanId">Edit</a> |
            <a asp-action="Index" class="btn btn-primary">Back to List</a>
        </div>
    </div>
</div>
